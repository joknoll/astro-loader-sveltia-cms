{
    "name": "astro-loader-sveltia-cms",
    "version": "0.3.0",
    "description": "Sveltia CMS integration for Astro",
    "keywords": [
        "astro-integration",
        "astro-loader",
        "sveltiacms",
        "withastro"
    ],
    "homepage": "https://github.com/joknoll/astro-loader-sveltia-cms#readme",
    "bugs": {
        "url": "https://github.com/joknoll/astro-loader-sveltia-cms/issues"
    },
    "license": "MIT",
    "author": "Johannes Knoll <mail@joknoll.de>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/joknoll/astro-loader-sveltia-cms.git"
    },
    "directories": {
        "example": "example"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": "./dist/index.mjs",
        "./loader": "./dist/loader.mjs",
        "./package.json": "./package.json",
        "./admin.astro": "./dist/admin.astro"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "test": "vp test",
        "check": "vp check",
        "format": "vp fmt .",
        "format:check": "vp fmt --check .",
        "prepublishOnly": "vp run build",
        "prepare": "vp config"
    },
    "dependencies": {
        "@sveltia/cms": "^0.269.2",
        "typescript": "^6.0.3",
        "zod": "^4.6.7",
        "zod-to-ts": "^2.1.0"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "astro": "catalog:",
        "vite": "catalog:",
        "vite-plus": "catalog:"
    },
    "peerDependencies": {
        "astro": "^7.0.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.21.0",
            "onFail": "download"
        }
    }
}
